# Environment variables (set in Render > Environment, or in run_local.bat). Leave all unset for demo mode.
# The first source that is configured wins, in this order:

# 1. Microsoft Graph (needs IT: Entra app registration with Files.Read.All + admin consent)
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=
GRAPH_DRIVE_ID=
GRAPH_ITEM_ID=
# or: GRAPH_USER=you@company.com  GRAPH_FILE_PATH=Documents/Dashboard/OPERATIONS Tracker.xlsx

# 2. Excel file on the PC running the app (* = any characters, newest file wins)
EXCEL_PATH=D:\OneDrive - Smart Services\OPERATIONS*Tracker*.xlsx
# EXCEL_IPR_PATH=D:\OneDrive - Smart Services\Updated IPR Tracker*.xlsx   (only if the IPR tracker is a separate file)

# 3. OneDrive/SharePoint share link ("Anyone with the link")
EXCEL_LINK=

# 4. Google Sheet ID (Share > Anyone with the link > Viewer)
GSHEET_ID=

# Optional
TARGET_PCT=85

# E-mail alerts (rows of the Alerts sheet are e-mailed once, on their alert date)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=person1@company.com,person2@company.com   # default recipients (a row's "Email To" overrides)
# SMTP_FROM=            (defaults to SMTP_USER)
# DASHBOARD_URL=        (link added to the e-mail)
# ALERT_ADMIN_KEY=      (set it, then open /alerts/test-email?key=<it> to send a test e-mail)
# TZ_OFFSET_MINUTES=330 (India; the server clock may be UTC)
